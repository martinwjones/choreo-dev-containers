{
  "name": "WSO2 & OpenChoreo Sandbox",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "installDockerCompose": false
    },
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "latest",
      "helm": "3.17.3",
      "minikube": "none"
    }
  },
  // Persist Claude Code login, settings, session history and memory across
  // container rebuilds. CLAUDE_CONFIG_DIR also moves ~/.claude.json into this dir.
  "mounts": [
    "source=wso2-claude-config,target=/home/vscode/.claude,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },
  // Hostnames used by the WSO2 ingress / gateway listeners, resolvable inside the container.
  "runArgs": [
    "--add-host=am.wso2.com:127.0.0.1",
    "--add-host=api.am.wso2.com:127.0.0.1",
    "--add-host=idp.am.wso2.com:127.0.0.1",
    "--add-host=default.gw.wso2.com:127.0.0.1"
  ],
  // Published by Docker itself (docker run -p), not VS Code port forwarding:
  // VS Code remaps privileged ports such as 443 to a random local port, which
  // breaks the APIM portals because they redirect to https://am.wso2.com/.
  "appPort": [
    "443:443",
    "80:80",
    "9095:9095",
    // Agent Manager (amp-local cluster). Ports must keep their numbers: the
    // console and Thunder login redirect to *.amp.localhost:8080.
    "8080:8080",
    "8443:8443",
    "11080:11080",
    "19080:19080",
    "19443:19443",
    // Recipe chatbot web app; ThunderID only accepts http://localhost:5173/ as its redirect URI.
    "5173:5173"
  ],
  "portsAttributes": {
    "443": { "label": "Ingress HTTPS (APIM portals: https://am.wso2.com)" },
    "80": { "label": "Ingress HTTP" },
    "9095": { "label": "APK gateway (https://default.gw.wso2.com:9095)" },
    "8080": { "label": "Agent Manager console (http://console.amp.localhost:8080)" },
    "8443": { "label": "OpenChoreo control plane HTTPS" },
    "11080": { "label": "OpenChoreo observer API" },
    "19080": { "label": "OpenChoreo data plane gateway HTTP (agents)" },
    "19443": { "label": "OpenChoreo data plane gateway HTTPS (agents)" },
    "5173": { "label": "Recipe chatbot web app (http://localhost:5173)" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "redhat.vscode-yaml",
        "redhat.java",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "postCreateCommand": "bash ./scripts/init-environment.sh"
}
