# Written by ../deploy.sh. Copy to .env only to run against a different agent.
# The agent's URL. A base URL is fine — /chat is appended when absent.
VITE_AGENT_URL=http://localhost:8000

# none | oauth
VITE_AUTH_MODE=none

# Required when VITE_AUTH_MODE=oauth. Register http://localhost:5173/ as the
# callback URL with your provider.
# VITE_OAUTH_ISSUER=http://default-idp.amp.localhost:8080
# VITE_OAUTH_CLIENT_ID=recipe-chat-web
# VITE_OAUTH_SCOPES=openid profile email

# VITE_APP_NAME=Recipe Chat
